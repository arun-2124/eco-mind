# ECO//MIND Environment Configuration
# When Supabase variables are set, the app connects to the remote Supabase PostgreSQL database.
# When left empty, ECO//MIND automatically falls back to the persistent local room store.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# STRICTLY SERVER-SIDE: Never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Presenter Command Center Access Passcode (STRICTLY SERVER-SIDE)
PRESENTER_PASSCODE=ecomind2045

# App URL (used for QR code invite links and join URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
