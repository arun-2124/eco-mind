# ECO//MIND Environment Configuration
# When Supabase variables are set, the app connects to the remote Supabase PostgreSQL & Realtime engine.
# When left empty, ECO//MIND automatically falls back to the fully-functional Local Demo Mode!

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Presenter Command Center Access Passcode
PRESENTER_PASSCODE=ecomind2045
NEXT_PUBLIC_PRESENTER_PASSCODE=ecomind2045

# App URL (used for QR code join URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
